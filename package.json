		"@wordpress/eslint-plugin": "^25.7.0",
		"@wordpress/i18n": "^6.24.0",
		"@wordpress/prettier-config": "^4.51.0",
		"@wordpress/stylelint-config": "^24.1.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
